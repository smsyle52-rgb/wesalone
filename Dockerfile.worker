# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

WORKDIR /app

ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsconfig.base.json ./
COPY artifacts/outbox-worker/package.json artifacts/outbox-worker/package.json
COPY lib/db/package.json lib/db/package.json

RUN corepack pnpm install --frozen-lockfile

COPY artifacts/outbox-worker ./artifacts/outbox-worker
COPY lib/db ./lib/db

RUN corepack pnpm --filter @workspace/outbox-worker run typecheck
RUN corepack pnpm --filter @workspace/outbox-worker run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

COPY --from=builder /app/artifacts/outbox-worker/dist ./artifacts/outbox-worker/dist

USER node

EXPOSE 8080

CMD ["node", "--enable-source-maps", "artifacts/outbox-worker/dist/index.mjs"]
