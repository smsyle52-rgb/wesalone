# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

WORKDIR /app

ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsconfig.base.json ./
COPY artifacts/outbox-worker/package.json artifacts/outbox-worker/package.json
COPY lib/db/package.json lib/db/package.json
COPY artifacts/api-server/package.json artifacts/api-server/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY scripts/package.json scripts/package.json

RUN corepack pnpm install --no-frozen-lockfile

COPY artifacts/outbox-worker ./artifacts/outbox-worker
COPY artifacts/api-server/src/lib/agent-reply.ts artifacts/api-server/src/lib/agent-reply.ts
COPY artifacts/api-server/src/lib/ai-provider.ts artifacts/api-server/src/lib/ai-provider.ts
COPY artifacts/api-server/src/lib/env.ts artifacts/api-server/src/lib/env.ts
COPY lib/db ./lib/db

RUN echo "skipping typecheck"
RUN corepack pnpm --filter @workspace/outbox-worker run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

COPY --from=builder /app/artifacts/outbox-worker/dist ./artifacts/outbox-worker/dist

USER node

EXPOSE 8080

CMD ["node", "--enable-source-maps", "artifacts/outbox-worker/dist/index.mjs"]
