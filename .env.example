# Copy to .env and fill. Never commit .env.

# Auth/session
SESSION_SECRET=
NODE_ENV=

# Database
DATABASE_URL=
DATABASE_URL_PROD=

# Cloud Build migration (documentation only; substitutions live in cloudbuild.yaml)
CLOUDSQL_INSTANCE_CONNECTION_NAME=
CLOUDBUILD_DB_CONNECTION_NAME=
CLOUDBUILD_DATABASE_URL_SECRET=DATABASE_URL

# Server
PORT=
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
LOG_LEVEL=
SERVE_STATIC=

# AI
AI_PROVIDER=
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.3
AI_EMBEDDINGS_DRY_RUN=

# Storage
STORAGE_PROVIDER=
GCS_BUCKET=
